      <column caption='Revenue Jitter' datatype='real' name='[Calculation_4195075685789696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_revenue] + (random() - 0.5) * 4000' />
      </column>
      <column caption='Profit Jitter ' datatype='real' name='[Calculation_4195080914448385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_profit] + (random() - 0.5) * 1000' />
      </column>
