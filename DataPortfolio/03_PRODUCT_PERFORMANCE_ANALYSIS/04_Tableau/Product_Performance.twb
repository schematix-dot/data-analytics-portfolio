  <actions>
    <action caption='Filter 1 (generated)' name='[Action2_5E5E65155D6040C4B2B95C660466978A]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Product Performance Dashboard' type='sheet' worksheet='Profit vs Revenue Scatter Plot' />
